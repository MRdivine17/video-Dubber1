# Copy this file to .env and fill in only what you have:
#     copy .env.example .env
# .env is git-ignored; never commit real keys. Real environment variables take priority over .env.
# Nothing here is required: with no keys, the pipeline still dubs end-to-end on the GPU
# (Whisper -> NLLB-200 -> XTTS voice cloning).

# ── Hugging Face ────────────────────────────────────────────────────────────────
# Needed only for gated models: IndicTrans2 (best Indian-language -> English translation)
# and pyannote (optional speaker diarization). Accept each model's terms on its Hugging Face
# page with the SAME account, then create a "Read" token at https://huggingface.co/settings/tokens
#   https://huggingface.co/ai4bharat/indictrans2-indic-en-1B
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# After setting it, download the model once:  python scripts/get_indictrans2.py
HF_TOKEN=

# ── LLM for the translation polish pass (optional) ──────────────────────────────
# The first one found is used. The model is picked automatically from the provider's
# model list unless you set DUB_LLM_MODEL. The web UI shows what was detected.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=          # alternative to ANTHROPIC_API_KEY
# ANTHROPIC_MODEL=               # default: claude-opus-5-5

# OpenAI, or any OpenAI-compatible server
OPENAI_API_KEY=
# OPENAI_BASE_URL=               # e.g. http://localhost:11434/v1 for Ollama, http://localhost:1234/v1 for LM Studio
# OPENAI_API_BASE=               # older name for OPENAI_BASE_URL, also accepted
# OPENAI_MODEL=                  # model on that server, e.g. llama3.1:8b

# Gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY=                # alternative name for GEMINI_API_KEY

# Local Ollama with no key: detected automatically when it is running.
# OLLAMA_HOST=http://localhost:11434

# Overrides (apply to whichever provider is used)
# DUB_LLM_PROVIDER=              # anthropic | openai | gemini | ollama | none (none = skip the LLM pass)
# DUB_LLM_MODEL=                 # any model your provider offers

# ── Advanced ────────────────────────────────────────────────────────────────────
# Once scripts/download_models.py has fetched every model, dubbing loads them offline.
# Set to 1 to let a run contact the model hubs anyway (e.g. to pick up model updates).
# DUB_ONLINE=1
